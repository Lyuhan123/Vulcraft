#version 450

#include "fog.glsl"

layout(location = 0) in vec3 Position;
layout(location = 1) in vec4 Color;

// The end-portal starfield (TileEntityEndPortalRenderer) draws POSITION_COLOR
// quads that carry NO UV attribute: every coordinate is generated by the GL
// fixed-function texGen stage. This pipeline is that stage reproduced - it is
// selected by PipelineManager.chooseShader only while texGen is enabled, so the
// plain position_color pipeline (and everything that shares it: the sky horizon
// box, GUI overlays, ...) is untouched.
layout(binding = 0) uniform ModelViewUBO {
    mat4 ModelViewMat;
    mat4 TextureMat;
    vec4 TexGenPlaneS;
    vec4 TexGenPlaneT;
    vec4 TexGenPlaneR;
    vec4 TexGenPlaneQ;
    float TexGenEnabled;
};

// The per-draw matrix lives in a push constant, not a UBO: it changes on
// every draw, and push constants need no descriptor set.
layout(push_constant) uniform PushConstants {
    mat4 MVP;
};

layout(location = 0) out vec4 vertexColor;
layout(location = 1) out float vertexDistance;
layout(location = 2) out vec2 texCoord0;

void main() {
    gl_Position = MVP * vec4(Position, 1.0);

    vec4 eyePos = ModelViewMat * vec4(Position, 1.0);
    vertexDistance = fog_distance(eyePos.xyz, 0);
    vertexColor = Color;

    // GL_EYE_LINEAR: each generated coordinate is the dot product of that
    // coordinate's eye plane with the eye-space vertex, and the GL_TEXTURE
    // matrix then transforms the whole (s,t,r,q) vector - so all four planes
    // matter, not just S and T. The end-portal renderer builds that texture
    // matrix from the projection and modelview (multMatrix(P) then
    // multMatrix(MV)), which is what gives the starfield its parallax-free,
    // screen-locked look; its R plane is (0,0,1,0), so dropping R (feeding 0)
    // would shear the pattern by the eye-space Z.
    if (TexGenEnabled > 0.5) {
        vec4 gen = vec4(dot(TexGenPlaneS, eyePos),
                        dot(TexGenPlaneT, eyePos),
                        dot(TexGenPlaneR, eyePos),
                        dot(TexGenPlaneQ, eyePos));
        texCoord0 = (TextureMat * gen).xy;
    } else {
        texCoord0 = vec2(0.0);
    }
}
